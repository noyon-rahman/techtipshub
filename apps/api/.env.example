# app
PORT="5000"
NODE_ENV="development"
API_BASE_URL="http://localhost:5000/api/v1"
CLIENT_BASE_URL="http://localhost:3000"
DATABASE_URL="your_mongodb_connection_string"

# jwt
JWT_ACCESS_TOKEN_SECRET="your_access_token_secret"
JWT_ACCESS_TOKEN_EXPIRES_IN="2d"
JWT_REFRESH_TOKEN_SECRET="your_refresh_token_secret"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"
JWT_RESET_PASSWORD_SECRET="your_reset_password_secret"
JWT_RESET_PASSWORD_EXPIRES_IN="30m"
# How long a verification link stays valid.
JWT_VERIFY_EMAIL_EXPIRES_IN="24h"

# mail, off until RESEND_API_KEY is set
RESEND_API_KEY=""
# The sending domain, verified in Resend. Every sender address is built from it.
MAIL_DOMAIN="techtipshub.noyonrahman.com"
# Where replies to our mail go. Must be a mailbox someone reads.
MAIL_REPLY_TO=""
# Where contact-form submissions are delivered.
CONTACT_INBOX=""

# hashing
BCRYPT_SALT_ROUND="10"

# google sign-in, off when empty
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Empty falls back to <API_BASE_URL>/auth/google/callback.
GOOGLE_REDIRECT_URI=""
# Signs the short-lived values a Google sign-in carries, including the handoff
# the site trades for its cookies. Set a long random value in production; empty
# falls back to JWT_ACCESS_TOKEN_SECRET.
GOOGLE_STATE_SECRET=""

# rate limits
# Sign-in, signup and Google-start attempts one address may make per window.
# A person never comes close; a password-guessing script hits it at once.
AUTH_RATE_LIMIT_MAX="15"
AUTH_RATE_LIMIT_WINDOW_MINUTES="15"
# Set to "false" only where the API is reachable without a proxy in front of
# it, or a caller can forge x-forwarded-for and step around the limits.
TRUST_PROXY="true"

# cloudinary
CLOUDINARY_CLOUD_NAME="your_cloudinary_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
