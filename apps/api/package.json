{
  "name": "@techtipshub/api",
  "version": "1.0.1",
  "description": "TechtipsHub REST API",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --env-file=.env.development ./src/main.ts",
    "start": "cross-env NODE_ENV=production node --env-file=.env.production ./dist/main.js",
    "dev:prod": "cross-env NODE_ENV=production tsx watch --env-file=.env.production ./src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier ./src --write",
    "format:check": "prettier ./src --check",
    "migrate:collections": "tsx --env-file=.env.development ./src/scripts/rename-collections.ts",
    "migrate:username-onboarding": "tsx --env-file=.env.development ./src/scripts/username-onboarding-backfill.ts",
    "migrate:remove-is-premium-user": "tsx --env-file=.env.development ./src/scripts/remove-is-premium-user.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noyonalways/techtipshub.git"
  },
  "keywords": [
    "hono",
    "mongoose",
    "typescript"
  ],
  "author": "Noyon Rahman",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/noyonalways/techtipshub/issues"
  },
  "homepage": "https://github.com/noyonalways/techtipshub#readme",
  "devDependencies": {
    "@techtipshub/eslint-config": "workspace:*",
    "@techtipshub/shared": "workspace:*",
    "@techtipshub/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mjml": "5.4.1",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "hono": "4.13.14",
    "hono-rate-limiter": "^0.5.4",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "mjml": "5.4.1",
    "mongoose": "^8.24.6",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  }
}
