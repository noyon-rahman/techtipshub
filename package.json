{
  "name": "techtipshub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "dev:api": "turbo run dev --filter=@techtipshub/api",
    "dev:web": "turbo run dev --filter=@techtipshub/web"
  },
  "devDependencies": {
    "turbo": "^2.6.1"
  }
}
